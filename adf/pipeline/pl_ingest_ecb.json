{
	"name": "pl_ingest_ecb",
	"properties": {
		"activities": [
			{
				"name": "set_load_date",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_load_date",
					"value": {
						"value": "@coalesce(pipeline().parameters.load_date,formatDateTime(utcNow(),'yyyy-MM-dd'))",
						"type": "Expression"
					}
				}
			},
			{
				"name": "set_start_period",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "set_load_date",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_start_period",
					"value": {
						"value": "@addDays(variables('v_load_date'), mul(pipeline().parameters.days_back, -1), 'yyyy-MM-dd')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "copy_ecb_to_landing",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "set_start_period",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "DelimitedTextSource",
						"storeSettings": {
							"type": "HttpReadSettings",
							"requestMethod": "GET"
						},
						"formatSettings": {
							"type": "DelimitedTextReadSettings"
						}
					},
					"sink": {
						"type": "DelimitedTextSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "DelimitedTextWriteSettings",
							"quoteAllText": true,
							"fileExtension": ".txt"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "ds_http_csv",
						"type": "DatasetReference",
						"parameters": {
							"relative_url": {
								"value": "@concat('data/EXR/D.USD+GBP+BRL+INR+PLN+CAD.EUR.SP00.A?startPeriod=',variables('v_start_period'),'&endPeriod=',variables('v_load_date'),'&format=csvdata')",
								"type": "Expression"
							}
						}
					}
				],
				"outputs": [
					{
						"referenceName": "ds_adls_landing_csvgz",
						"type": "DatasetReference",
						"parameters": {
							"source": "ecb",
							"table": "exchange_rates",
							"file_name": {
								"value": "@concat('ecb_exr_',variables('v_load_date'),'.csv.gz')",
								"type": "Expression"
							},
							"load_date": {
								"value": "@variables('v_load_date')",
								"type": "Expression"
							}
						}
					}
				]
			}
		],
		"parameters": {
			"load_date": {
				"type": "string"
			},
			"days_back": {
				"type": "int",
				"defaultValue": 5
			}
		},
		"variables": {
			"v_load_date": {
				"type": "String"
			},
			"v_start_period": {
				"type": "String"
			}
		},
		"annotations": []
	}
}