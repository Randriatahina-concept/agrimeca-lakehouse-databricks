{
	"name": "pl_ingest_ecb",
	"properties": {
		"activities": [
			{
				"name": "set_load_date",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_load_date",
					"value": {
						"value": "@coalesce(pipeline().parameters.load_date,formatDateTime(utcNow(),'yyyy-MM-dd'))",
						"type": "Expression"
					}
				}
			},
			{
				"name": "set_start_period",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "set_load_date",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_start_period",
					"value": {
						"value": "@addDays(variables('v_load_date'), mul(pipeline().parameters.days_back, -1), 'yyyy-MM-dd')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "copy_ecb_to_landing",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "set_start_period",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"enableStaging": false
				}
			}
		],
		"parameters": {
			"load_date": {
				"type": "string"
			},
			"days_back": {
				"type": "int",
				"defaultValue": 5
			}
		},
		"variables": {
			"v_load_date": {
				"type": "String"
			},
			"v_start_period": {
				"type": "String"
			}
		},
		"annotations": []
	}
}